rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // The owner of a workspace: its own Firebase user, or the Firebase user that claimed an old
    // 'sim_' account (accounts/{id}, see src/services/accounts.ts).
    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId
        || get(/databases/$(database)/documents/accounts/$(userId)).data.owner == request.auth.uid);
    }

    // A management member (partner, manager) the owner invited, see src/services/members.ts.
    function memberDoc(userId) {
      return /databases/$(database)/documents/accounts/$(userId)/members/$(request.auth.uid);
    }

    function isMember(userId) {
      return isSignedIn() && exists(memberDoc(userId));
    }

    function memberCan(userId, perm) {
      return isSignedIn() && get(memberDoc(userId)).data.perms.get(perm, false) == true;
    }

    // The owner or a member: works in the account's editor and admin window.
    function canManage(userId) {
      return isOwner(userId) || isMember(userId);
    }

    function isValidPerms(p) {
      return p is map && p.keys().hasOnly(['orders', 'menu', 'tables', 'staff', 'accounts', 'settings']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The shared workspace shown while nobody is signed in.
    function isDemo(userId) {
      return userId == 'mouhamadeiah';
    }

    // Design document schema validation helper (allows partial/merge updates)
    function isValidDesign(data, userId) {
      return (!('userId' in data) || data.userId == userId)
        && (!('pages' in data) || data.pages is list)
        && (!('elements' in data) || data.elements is list)
        && (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is string);
    }

    // Match statement for the designs collection
    match /designs/{userId} {
      allow get: if canManage(userId) || isDemo(userId);
      allow list: if false; // Users can only fetch their own design document directly by UID, no list queries
      
      allow create, update: if (canManage(userId) || isDemo(userId))
        && isValidId(userId)
        && isValidDesign(incoming(), userId)
        && (!('createdAt' in incoming()) || incoming().createdAt == request.time || incoming().createdAt is string);
        
      allow delete: if isOwner(userId) || isDemo(userId);

      // The account's later projects, one doc each (see src/services/projects.ts). The first project
      // of each kind stays in the doc above.
      match /projects/{key} {
        allow read: if canManage(userId);
        allow create, update: if canManage(userId)
          && key.matches('^(page|shop|cars|restaurant)-[a-z0-9]{4,12}$')
          && (!('kind' in incoming()) || incoming().kind == key.split('-')[0])
          && isValidDesign(incoming(), userId)
          && (!('createdAt' in incoming()) || incoming().createdAt == request.time || incoming().createdAt is string);
        allow delete: if isOwner(userId);
      }
    }

    // Restaurant projects (see src/components/restaurant/restaurantCloud.ts).
    // The published site is public; guests can only add orders; the bills, the orders and the accounts
    // belong to the owner and to the restaurant's devices (a tablet linked with a working device code).
    // The account a restaurant id (or a page's owner id) belongs to: the id itself, or the account
    // part of a later restaurant's '{uid}__restaurant-xxxxxx'.
    function restaurantOwner(id) {
      return id.matches('^.+__restaurant-[a-z0-9]{4,12}$') ? id.split('__restaurant-')[0] : id;
    }

    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canManage(owner()) && isValidId(restaurantId);
      allow delete: if isOwner(owner());

      // The account that owns the restaurant: its first restaurant has the account's id, a later one
      // '{uid}__restaurant-xxxxxx' (see src/utils/projectKeys.ts).
      function owner() {
        return restaurantOwner(restaurantId);
      }

      function staffCodes() {
        return get(/databases/$(database)/documents/restaurants/$(restaurantId)/private/staff).data.codes;
      }

      // This browser's sign-in was linked with the code of a device that still works.
      function isDevice() {
        return isSignedIn()
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/deviceLinks/$(request.auth.uid)).data.code in staffCodes();
      }

      // The conditions are the same as ever, but ordered by how few lookups they need: the restaurant's
      // own sign-in none, a linked device two, the claimed account and the members more. Each lookup is
      // a read inside the rules, and the tablets' every write pays for them.
      function isStaff() {
        return (isSignedIn() && request.auth.uid == owner()) || isDevice() || canManage(owner());
      }

      // A guest's order comes with its sign-in's mark in guestRate, written in the same transaction; the mark
      // can only move forward 20 seconds after the last one, so one browser can't flood the kitchen.
      function guestRateTaken() {
        return isSignedIn()
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/guestRate/$(request.auth.uid)).data.at == request.time;
      }

      function acceptsOrders() {
        let r = get(/databases/$(database)/documents/restaurants/$(restaurantId));
        return r.data.settings.acceptOrders == true;
      }

      function isValidNewOrder(data, orderId) {
        return data.keys().hasOnly(['id', 'number', 'createdAt', 'status', 'type', 'source', 'table', 'name', 'phone', 'address', 'notes', 'lines', 'subtotal', 'deliveryFee', 'total', 'customerUid'])
          && data.id == orderId
          && (!('customerUid' in data) || (isSignedIn() && data.customerUid == request.auth.uid))
          && data.status == 'new'
          && data.type in ['delivery', 'pickup', 'table']
          && data.source in ['website', 'qr']
          && data.number is int
          && data.createdAt is string && data.createdAt.size() <= 40
          && data.table is string && data.table.size() <= 20
          && data.name is string && data.name.size() <= 100
          && data.phone is string && data.phone.size() <= 40
          && data.address is string && data.address.size() <= 300
          && data.notes is string && data.notes.size() <= 500
          && data.lines is list && data.lines.size() > 0 && data.lines.size() <= 60
          && data.subtotal is number && data.deliveryFee is number && data.total is number
          && data.total >= 0 && data.total < 1000000000;
      }

      // The devices (with their codes) and the workers (with their PINs), written by the owner's
      // editor; the devices read them to sign the workers in.
      match /private/{docId} {
        allow get: if docId == 'staff' && (isOwner(owner()) || memberCan(owner(), 'staff') || isDevice());
        allow create, update, delete: if docId == 'staff' && (isOwner(owner()) || memberCan(owner(), 'staff'));
      }

      // A tablet links its sign-in with its code; only the code of a working device is accepted.
      match /deviceLinks/{authUid} {
        allow get: if isSignedIn() && request.auth.uid == authUid;
        allow create, update: if isSignedIn() && request.auth.uid == authUid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code is string
          && request.resource.data.code in staffCodes();
        allow delete: if isOwner(owner()) || memberCan(owner(), 'staff') || (isSignedIn() && request.auth.uid == authUid);
      }

      match /orders/{orderId} {
        // Guests add new orders only; the staff (cashier, waiters) add theirs from their devices.
        allow create: if isValidId(orderId) && (
          (isValidNewOrder(request.resource.data, orderId) && acceptsOrders() && guestRateTaken())
          || isStaff());
        allow get, list: if (isSignedIn() && resource.data.customerUid == request.auth.uid) || isStaff();
        allow update: if isStaff();
        allow delete: if isOwner(owner());
      }

      match /guestRate/{guestUid} {
        allow create: if isSignedIn() && request.auth.uid == guestUid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow update: if isSignedIn() && request.auth.uid == guestUid
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && request.time > resource.data.at + duration.value(20, 's');
      }

      // The day's order count (1, 2, 3...). A guest's order takes the next number in its transaction:
      // a guest may only start the day at 1 or add exactly 1.
      match /counters/{day} {
        allow get: if isValidId(day);
        allow create: if isValidId(day) && ((request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1) || isStaff());
        allow update: if isValidId(day) && ((request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1) || isStaff());
      }

      // The cashier and the waiters: bills, tills, the customer screens, the log of sensitive actions and the workers' sessions.
      match /{staffCollection}/{docId} {
        allow read: if staffCollection in ['tabs', 'shifts', 'screens', 'log', 'sessions', 'handovers'] && isStaff();
        allow write: if staffCollection in ['tabs', 'shifts', 'screens', 'log', 'sessions', 'handovers'] && isStaff() && isValidId(docId);
      }

      // Gift cards (بطاقة رصيد): staff read and write them. A card can be fetched by its exact number (never listed),
      // which is how the website checks a number a guest typed; spending is booked by staff only.
      match /giftCards/{number} {
        allow get: if number.matches('^[0-9]{16}$');
        allow list: if isStaff();
        allow write: if isStaff() && number.matches('^[0-9]{16}$');
      }

      // The main cashier's sessions and their reports (kept two years): the devices write them, the accounts' readers read them.
      match /cashDays/{dayId} {
        allow read: if isStaff() || memberCan(owner(), 'accounts');
        allow write: if isStaff() && isValidId(dayId);
      }

      // The accounts: only the owner (and members allowed to) read them; the devices book their payments.
      match /ledger/{entryId} {
        allow read: if isOwner(owner()) || memberCan(owner(), 'accounts');
        allow write: if isStaff() && isValidId(entryId);
      }
    }

    // Every gift card number ever issued, by any restaurant, so one is never issued twice. Anyone signed in (the
    // cashier devices sign in anonymously) can book a new number; a booked number can never change.
    match /giftCardNumbers/{number} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && number.matches('^[0-9]{16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128;
    }

    // The old accounts (before Firebase sign-in) and their move to Firebase users, see
    // src/services/accounts.ts. Nobody can list them, read someone else's or make new ones; the only
    // change allowed is deleting the plain-text password.
    match /simulated_users/{email} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/legacyClaims/$(email)).data.authUid == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isOwner(resource.data.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'migratedTo'])
        && !('password' in request.resource.data)
        && request.resource.data.migratedTo == request.auth.uid;
    }

    // Proof that a Firebase user (with the same email) knows an old account's password.
    match /legacyClaims/{email} {
      allow create, update: if isSignedIn()
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['authUid', 'password'])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.password == get(/databases/$(database)/documents/simulated_users/$(email)).data.password;
      allow delete: if isSignedIn() && resource.data.authUid == request.auth.uid;
    }

    // Which Firebase user owns an old account. Made once, by the user that proved its password.
    match /accounts/{accountId} {
      allow get: if isSignedIn() && resource.data.owner == request.auth.uid;
      allow create: if isSignedIn() && isValidId(accountId)
        && request.resource.data.keys().hasOnly(['owner', 'email', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.email is string
        && get(/databases/$(database)/documents/legacyClaims/$(request.resource.data.email)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/simulated_users/$(request.resource.data.email)).data.uid == accountId;

      // Invitation links the owner sends to a partner or a manager (the code is the secret).
      match /invites/{code} {
        allow get: if isSignedIn() && (isOwner(accountId) || resource.data.email == request.auth.token.email);
        allow list: if isOwner(accountId);
        allow create: if isOwner(accountId) && isValidId(code) && code.size() >= 20
          && request.resource.data.keys().hasOnly(['email', 'name', 'perms', 'by', 'at'])
          && request.resource.data.email is string && request.resource.data.email.size() <= 200
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && isValidPerms(request.resource.data.perms)
          && request.resource.data.by == request.auth.uid;
        allow delete: if isOwner(accountId) || (isSignedIn() && resource.data.email == request.auth.token.email);
      }

      function inviteFor(code) {
        return get(/databases/$(database)/documents/accounts/$(accountId)/invites/$(code)).data;
      }

      // The members. A member joins with an invitation for the email it signed in with, taking exactly
      // the permissions the owner chose; only the owner changes them. A member may leave.
      match /members/{memberUid} {
        allow get: if isSignedIn() && (request.auth.uid == memberUid || isOwner(accountId));
        allow list: if isOwner(accountId);
        allow create: if isSignedIn() && request.auth.uid == memberUid && memberUid != accountId
          && request.resource.data.keys().hasOnly(['email', 'name', 'perms', 'invite', 'at'])
          && request.resource.data.invite is string
          && inviteFor(request.resource.data.invite).email == request.auth.token.email
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name == inviteFor(request.resource.data.invite).name
          && request.resource.data.perms == inviteFor(request.resource.data.invite).perms;
        allow update: if isOwner(accountId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perms', 'name'])
          && isValidPerms(request.resource.data.perms);
        allow delete: if isOwner(accountId) || (isSignedIn() && request.auth.uid == memberUid);
      }
    }

    // Where a Firebase user's workspace is (an old account it claimed, or an account it is a member of).
    match /userAccounts/{authUid} {
      allow get: if isSignedIn() && request.auth.uid == authUid;
      allow create, update: if isSignedIn() && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['accountId'])
        && request.resource.data.accountId is string
        && (request.resource.data.accountId == authUid
          || canManage(request.resource.data.accountId));
    }

    // The customers of a page (see src/services/pageCustomers.ts), by its owner's id; a later
    // restaurant keeps its own customers under its own id. A customer joins with a confirmed
    // email (the email code, or Google) and writes only their own entry; the page's owner and the
    // members allowed to see orders read the list, and the owner may remove someone from it.
    function isValidCustomer(data) {
      return data.keys().hasOnly(['email', 'name', 'phone', 'address', 'marketing', 'joinedAt', 'updatedAt'])
        && data.email == request.auth.token.email.lower()
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 40
        && data.address is string && data.address.size() <= 300
        && data.marketing is bool
        && data.joinedAt is string && data.joinedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isConfirmedUser(uid) {
      return isSignedIn() && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    match /pageCustomers/{ownerId}/customers/{customerUid} {
      allow get: if (isSignedIn() && request.auth.uid == customerUid) || isOwner(restaurantOwner(ownerId)) || memberCan(restaurantOwner(ownerId), 'orders');
      allow list: if isOwner(restaurantOwner(ownerId)) || memberCan(restaurantOwner(ownerId), 'orders');
      allow create: if isValidId(ownerId) && isConfirmedUser(customerUid) && isValidCustomer(incoming());
      allow update: if isConfirmedUser(customerUid) && isValidCustomer(incoming()) && incoming().joinedAt == existing().joinedAt;
      allow delete: if (isSignedIn() && request.auth.uid == customerUid) || isOwner(restaurantOwner(ownerId));
    }

    // The pages a customer joined, for their own weelink.de.
    match /customerPages/{customerUid}/pages/{ownerId} {
      allow read: if isSignedIn() && request.auth.uid == customerUid;
      allow delete: if isSignedIn() && request.auth.uid == customerUid;
      allow create, update: if isConfirmedUser(customerUid) && isValidId(ownerId)
        && incoming().keys().hasOnly(['name', 'kind', 'joinedAt'])
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().kind in ['restaurant', 'shop', 'cars', 'site']
        && incoming().joinedAt is string && incoming().joinedAt.size() <= 40;
    }

    // Published pages (see src/services/sites.ts). The names and the published copies are public;
    // only the page's owner or a management member writes them, and a name belongs to one page.
    function isSiteName(name) {
      return name is string && name.size() >= 3 && name.size() <= 30 && name.matches('^[a-z0-9]([a-z0-9-]*[a-z0-9])?$');
    }

    // A project key (src/utils/projectKeys.ts): the kind for an account's first project of it,
    // else the kind and the project's own id.
    function isProjectKind(p) {
      return p is string && p.matches('^(page|shop|cars|restaurant)(-[a-z0-9]{4,12})?$');
    }

    // The page's title, description and keywords (for Google and Weelink's search).
    function isSeo(m) {
      return (!('title' in m) || (m.title is string && m.title.size() <= 70))
        && (!('description' in m) || (m.description is string && m.description.size() <= 300))
        && (!('keywords' in m) || (m.keywords is list && m.keywords.size() <= 15))
        && (!('shareText' in m) || (m.shareText is string && m.shareText.size() <= 200));
    }

    match /siteNames/{name} {
      allow get: if true;
      // Weelink's search (keywords array-contains a word).
      allow list: if request.query.limit <= 50;
      allow create: if isSiteName(name)
        && incoming().keys().hasOnly(['owner', 'project', 'kind', 'at', 'title', 'description', 'keywords', 'shareText'])
        && isSeo(incoming())
        && isProjectKind(incoming().project)
        && (!('kind' in incoming()) || incoming().kind == incoming().project.split('-')[0])
        && incoming().at is string
        && canManage(incoming().owner);
      allow update: if canManage(existing().owner)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'keywords', 'shareText'])
        && isSeo(incoming());
      allow delete: if canManage(existing().owner);
    }

    // Paying before publishing (server/billing.ts): once the team turns it on (platformSettings/billing),
    // a restaurant, shop or showroom (or a page once it was Pro) is published only while its paid period
    // runs, or by a test account.
    function billingOk(owner, project) {
      let settings = /databases/$(database)/documents/platformSettings/billing;
      let access = /databases/$(database)/documents/projectAccess/$(owner + '__' + project);
      return !exists(settings) || get(settings).data.get('enforce', false) != true
        || (project.matches('^page(-[a-z0-9]{4,12})?$') && !exists(access))
        || exists(/databases/$(database)/documents/testAccounts/$(owner))
        || (exists(access) && get(access).data.get('paidUntil', 0) > request.time.toMillis());
    }

    match /publishedSites/{siteId} {
      allow get: if true;
      allow create, update: if billingOk(incoming().owner, incoming().project)
        && incoming().keys().hasOnly(['name', 'project', 'owner', 'pages', 'elements', 'data', 'publishedAt', 'hash', 'customDomain', 'icon', 'seo', 'place'])
        && (!('place' in incoming()) || incoming().place == null || (incoming().place is map && incoming().place.size() <= 12))
        && (!('seo' in incoming()) || (incoming().seo is map && incoming().seo.keys().hasOnly(['title', 'description', 'keywords', 'shareText']) && isSeo(incoming().seo)))
        && (!('icon' in incoming()) || (incoming().icon is string && incoming().icon.size() <= 200000))
        && isProjectKind(incoming().project)
        && siteId == incoming().owner + '__' + incoming().project
        && canManage(incoming().owner)
        && getAfter(/databases/$(database)/documents/siteNames/$(incoming().name)).data.owner == incoming().owner
        && getAfter(/databases/$(database)/documents/siteNames/$(incoming().name)).data.project == incoming().project
        && incoming().pages is list && incoming().elements is list
        // The custom domain is set by the server (api/domains.ts) only.
        && (resource == null ? incoming().customDomain == null : incoming().customDomain == existing().customDomain);
      allow delete: if canManage(existing().owner);
    }

    // A customer's own domain → the page's name. Written by the server only.
    match /siteDomains/{host} {
      allow get: if true;
    }

    // Requests to buy a domain through Weelink, handled by the office.
    match /domainOrders/{orderId} {
      allow get: if isSignedIn() && canManage(existing().owner);
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['owner', 'project', 'domain', 'years', 'contact', 'price', 'status', 'by', 'at'])
        && canManage(incoming().owner)
        && isProjectKind(incoming().project)
        && incoming().domain is string && incoming().domain.size() <= 253
        && incoming().years is int && incoming().years >= 1 && incoming().years <= 10
        && incoming().contact is map && incoming().contact.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'address', 'city', 'zip', 'country'])
        && incoming().status == 'requested'
        && incoming().by == request.auth.uid;
    }

    // A published page's daily counters (src/services/siteStats.ts): a visitor adds exactly 1 to
    // the visits or the contacts; only the owner and the members read them.
    match /siteStats/{ownerId}/days/{dayId} {
      allow read: if canManage(ownerId);
      allow create: if isValidId(ownerId) && isValidId(dayId)
        && incoming().keys().hasOnly(['visits', 'contacts']) && incoming().keys().size() == 1
        && incoming().get('visits', 1) == 1 && incoming().get('contacts', 1) == 1;
      allow update: if isValidId(ownerId) && isValidId(dayId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['visits', 'contacts'])
        && incoming().get('visits', 0) - existing().get('visits', 0) + incoming().get('contacts', 0) - existing().get('contacts', 0) == 1
        && incoming().get('visits', 0) >= existing().get('visits', 0)
        && incoming().get('contacts', 0) >= existing().get('contacts', 0);
    }

    // Appointments booked from a page's «حجز مواعيد» calendar (api/booking.ts writes them):
    // the owner and the members read their bookings; anyone reads which times of a day are taken.
    match /bookings/{ownerId}/items/{bookingId} {
      allow read: if canManage(ownerId);
    }
    match /bookingDays/{dayId} {
      allow get: if true;
    }

    // Messages from a page's «نموذج تواصل» (api/contact.ts creates them): the owner and the members read them,
    // mark them read and delete them. contactLimits (the per-hour counters) are the function's alone.
    match /inquiries/{ownerId}/items/{inquiryId} {
      allow read, delete: if canManage(ownerId);
      allow update: if canManage(ownerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // A page's ratings (api/rating.ts writes them after the rater confirmed their email): anyone
    // reads them and the page's stars; nobody, the owner included, changes or deletes them here.
    match /ratings/{ownerId}/items/{ratingId} {
      allow read: if true;
    }
    match /ratingSummary/{summaryId} {
      allow get: if true;
    }

    // The designers' programme (src/services/designers.ts): a public profile per designer, shown in the
    // gallery. A designer writes only their own name and line; likes, ratings and the approved badge are
    // written by the server in later phases, so the rules keep them out of this document.
    match /designers/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidId(uid)
        && incoming().keys().hasOnly(['name', 'bio', 'createdAt'])
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 60
        && incoming().bio is string && incoming().bio.size() <= 200
        && incoming().createdAt is string && incoming().createdAt.size() <= 40;
      allow update: if isSignedIn() && request.auth.uid == uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio'])
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 60
        && incoming().bio is string && incoming().bio.size() <= 200;
      allow delete: if false;
    }

    // The designers' drafts (src/services/designerDrafts.ts): up to ten slides a designer works on in
    // «وضع المصمم», apart from their own page. Only the designer reads and writes them, and only in
    // the ten slots d1..d10.
    match /designerDrafts/{uid}/items/{slot} {
      function isDesignerAccount() {
        return exists(/databases/$(database)/documents/designers/$(uid));
      }

      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isDesignerAccount()
        && slot in ['d1', 'd2', 'd3', 'd4', 'd5', 'd6', 'd7', 'd8', 'd9', 'd10']
        && incoming().keys().hasOnly(['name', 'kind', 'pages', 'elements', 'updatedAt'])
        && (!('kind' in incoming()) || incoming().kind in ['slide', 'page'])
        && incoming().name is string && incoming().name.size() <= 60
        && incoming().pages is list && incoming().pages.size() <= 5
        && incoming().elements is list && incoming().elements.size() <= 400;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // The gallery's slides and pages (src/services/gallery.ts). A designer exports a design as 'pending', having
    // agreed to the current version of the page's law; only the platform's admin (api/admin.ts)
    // approves or rejects it, so nobody changes a slide's status from the browser. The gallery
    // reads approved slides; a designer reads their own, whatever their status.
    match /gallerySlides/{slideId} {
      allow get: if resource.data.status == 'approved' || (isSignedIn() && resource.data.designerUid == request.auth.uid);
      allow list: if resource.data.status == 'approved' || (isSignedIn() && resource.data.designerUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(slideId)
        && exists(/databases/$(database)/documents/designers/$(request.auth.uid))
        && incoming().keys().hasOnly(['designerUid', 'designerName', 'name', 'category', 'draftSlot', 'kind', 'slide', 'page', 'elements', 'status', 'lawVersion', 'acceptedAt', 'createdAt'])
        && incoming().kind in ['slide', 'page']
        // A page is its navbar and one to three slides; a slide has no page.
        && (incoming().kind == 'page'
          ? (incoming().page is map && incoming().page.slides is list && incoming().page.slides.size() >= 1 && incoming().page.slides.size() <= 3)
          : !('page' in incoming()))
        && incoming().designerUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 60
        && incoming().designerName is string && incoming().designerName.size() <= 60
        && incoming().category is string && incoming().category.size() <= 30
        && incoming().draftSlot is string && incoming().draftSlot.size() <= 4
        && incoming().slide is map
        && incoming().elements is list && incoming().elements.size() <= 400
        && incoming().lawVersion is int
        && incoming().lawVersion == get(/databases/$(database)/documents/platformSettings/pageLaw).data.version
        && incoming().acceptedAt is string && incoming().acceptedAt.size() <= 40
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.designerUid == request.auth.uid;
    }

    // A voter's likes and dislikes on gallery slides (api/gallery.ts writes them, with the slides'
    // counters): they read their own, to show which slides they voted on.
    match /galleryVotes/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
    }

    // Hiring a designer (api/design-orders.ts writes everything here, the browser nothing): the customer
    // and the designer of an order read it and its messages. The customer's name and email are not in it.
    match /designOrders/{orderId} {
      allow get: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.designerUid == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.designerUid == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/designOrders/$(orderId)).data.customerUid == request.auth.uid
          || get(/databases/$(database)/documents/designOrders/$(orderId)).data.designerUid == request.auth.uid);
      }
    }

    // Platform settings the browser may read: the page's law (written by the admin site only).
    match /platformSettings/{docId} {
      allow get: if docId in ['pageLaw', 'billing'];
    }

    // A project's paid period and the test accounts (server/billing.ts writes them): the published page
    // and «نشر» check them, so anyone may read one by its id.
    match /projectAccess/{accessId} {
      allow get: if true;
    }
    match /testAccounts/{uid} {
      allow get: if true;
    }

    // A frozen or cancelled subscriber (the admin site, api/admin.ts writes it): anyone may check
    // whether a workspace id is in the list, so its published pages show «غير متاحة مؤقتاً».
    match /suspendedAccounts/{accountId} {
      allow get: if true;
    }

    // Match statement for platform_directory onboarding steps
    match /platform_directory/{userId} {
      allow get, write: if canManage(userId) || isDemo(userId);
    }
  }
}
