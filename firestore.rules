rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSimulatedOrPublic(userId) {
      return userId == 'mouhamadeiah' || userId.matches('^sim_[a-zA-Z0-9_\\-]+$');
    }

    // Design document schema validation helper (allows partial/merge updates)
    function isValidDesign(data, userId) {
      return (!('userId' in data) || data.userId == userId)
        && (!('pages' in data) || data.pages is list)
        && (!('elements' in data) || data.elements is list)
        && (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is string);
    }

    // Match statement for the designs collection
    match /designs/{userId} {
      allow get: if isOwner(userId) || isSimulatedOrPublic(userId);
      allow list: if false; // Users can only fetch their own design document directly by UID, no list queries
      
      allow create, update: if (isOwner(userId) || isSimulatedOrPublic(userId))
        && isValidId(userId)
        && isValidDesign(incoming(), userId)
        && (!('createdAt' in incoming()) || incoming().createdAt == request.time || incoming().createdAt is string);
        
      allow delete: if isOwner(userId) || isSimulatedOrPublic(userId);
    }

    // Restaurant projects (see src/components/restaurant/restaurantCloud.ts).
    // The published site is public; orders can only be added by guests; accounts are owner-only.
    match /restaurants/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (isOwner(userId) || isSimulatedOrPublic(userId)) && isValidId(userId);
      allow delete: if isOwner(userId) || isSimulatedOrPublic(userId);

      function acceptsOrders() {
        let r = get(/databases/$(database)/documents/restaurants/$(userId));
        return r.data.settings.acceptOrders == true;
      }

      function isValidNewOrder(data, orderId) {
        return data.keys().hasOnly(['id', 'number', 'createdAt', 'status', 'type', 'source', 'table', 'name', 'phone', 'address', 'notes', 'lines', 'subtotal', 'deliveryFee', 'total'])
          && data.id == orderId
          && data.status == 'new'
          && data.type in ['delivery', 'pickup', 'table']
          && data.source in ['website', 'qr']
          && data.number is int
          && data.createdAt is string && data.createdAt.size() <= 40
          && data.table is string && data.table.size() <= 20
          && data.name is string && data.name.size() <= 100
          && data.phone is string && data.phone.size() <= 40
          && data.address is string && data.address.size() <= 300
          && data.notes is string && data.notes.size() <= 500
          && data.lines is list && data.lines.size() > 0 && data.lines.size() <= 60
          && data.subtotal is number && data.deliveryFee is number && data.total is number
          && data.total >= 0 && data.total < 1000000000;
      }

      match /orders/{orderId} {
        // Guests add new orders only; the staff (cashier, waiters) add theirs with the owner's access.
        allow create: if isValidId(orderId) && (
          (isValidNewOrder(request.resource.data, orderId) && acceptsOrders())
          || isOwner(userId) || isSimulatedOrPublic(userId));
        allow get, list, update, delete: if isOwner(userId) || isSimulatedOrPublic(userId);
      }

      // The cashier and the waiters: bills, tills, the customer screens and the log of sensitive actions.
      match /{staffCollection}/{docId} {
        allow read: if staffCollection in ['tabs', 'shifts', 'screens', 'log'] && (isOwner(userId) || isSimulatedOrPublic(userId));
        allow write: if staffCollection in ['tabs', 'shifts', 'screens', 'log'] && (isOwner(userId) || isSimulatedOrPublic(userId)) && isValidId(docId);
      }

      match /ledger/{entryId} {
        allow read: if isOwner(userId) || isSimulatedOrPublic(userId);
        allow write: if (isOwner(userId) || isSimulatedOrPublic(userId)) && isValidId(entryId);
      }
    }

    // Match statement for simulated_users login/registration
    match /simulated_users/{email} {
      allow get, create, update: if true;
    }

    // Match statement for platform_directory onboarding steps
    match /platform_directory/{userId} {
      allow get, write: if isOwner(userId) || isSimulatedOrPublic(userId);
    }
  }
}
