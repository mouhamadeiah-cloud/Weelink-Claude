rules_version = '2';
// Firebase Storage. Publish in Firebase → Storage → Rules (like firestore.rules).
// Each account uploads into users/{uid}/ (src/utils/storagePaths.ts); a deleted customer's folder is
// removed by the server (server/billing.ts). Photos are shown on public pages, so reading is open.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // The shared folders of older photos, and uploads made while nobody is signed in.
    match /{folder}/{file} {
      allow read: if true;
      allow create: if folder in ['images', 'backgrounds', 'gallery'] && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
