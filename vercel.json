{
  "functions": {
    "api/build-page.ts": {
      "maxDuration": 60
    },
    "api/booking.ts": {
      "maxDuration": 60
    },
    "api/admin.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/booking",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/designers?area=orders",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/gallery",
      "destination": "/api/designers?area=gallery"
    },
    {
      "source": "/api/design-orders",
      "destination": "/api/designers?area=orders"
    },
    {
      "source": "/api/design-access",
      "destination": "/api/designers?area=access"
    }
  ]
}
