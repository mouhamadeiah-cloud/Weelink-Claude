// Cloudflare Workers config (trial). "name" must match the Worker project in the Cloudflare dashboard.
// Workers Builds runs `npm run build` then `npx wrangler deploy`.
// Secrets (RESEND_API_KEY, FIREBASE_SERVICE_ACCOUNT, GEMINI_API_KEY, CRON_SECRET, ...) are set with
// `npx wrangler secret put NAME` or in the dashboard, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weelink-claude",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/media"]
  },
  // Photos (worker/upload-image.ts, GET /img/*). The bucket is created in the dashboard: R2 → Create bucket.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "weelink-images" }],
  "triggers": { "crons": ["0 6 * * *", "0 7 * * *", "0 8 * * *", "0 3 * * *"] },
  "observability": { "enabled": true }
}
